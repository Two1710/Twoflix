# Configure credentials locally in .env and on the hosting provider.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required for announcements shared across all visitors (Upstash Redis REST).
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=replace-with-your-upstash-rest-token
